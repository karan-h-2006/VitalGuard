# ==============================================================================
# VitalGuard Production Environment Variables
# Copy this file to .env.prod before starting:
#   cp infra/.env.prod.example infra/.env.prod
# Generate secrets with:
#   openssl rand -hex 32
# ==============================================================================

# Domain & TLS Configuration
# Set DOMAIN to your public DNS record (e.g., vitalguard.example.com) for automatic HTTPS via Let's Encrypt.
# Leave as localhost or your server IP for development/staging with self-signed TLS.
DOMAIN=localhost
ACME_EMAIL=admin@vitalguard.local

# General Environment
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL Configuration
POSTGRES_DB=vitalguard
POSTGRES_USER=vitalguard
# Set a strong password in production (openssl rand -hex 16)
POSTGRES_PASSWORD=CHANGE_ME_IN_PROD_postgres_password_min16chars

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=vitalguard
# Set a strong password in production (openssl rand -hex 16)
RABBITMQ_DEFAULT_PASS=CHANGE_ME_IN_PROD_rabbitmq_password_min16chars

# JWT Authentication Secrets
# Mandatory: generate a 64-char hex secret (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_IN_PROD_jwt_secret_min32chars_long_and_random
JWT_EXPIRES_IN=1h
ADMIN_JWT_EXPIRES_IN=30m

# Simulator Service Token
# Shared secret for internal device discovery endpoint (GET /internal/simulated-devices)
# Generatable with: openssl rand -hex 24
SIMULATOR_SERVICE_TOKEN=CHANGE_ME_IN_PROD_sim_token_shared_between_api_and_simulator

# Simulator Feature Configuration
# When set to true, newly registered patient accounts automatically receive a registered simulated device.
AUTO_PROVISION_SIMULATED_DEVICE=true

# Notification Provider (Optional - leave empty for mock logging)
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@vitalguard.local
ADMIN_NOTIFY_EMAIL=admin@vitalguard.local

# External Hardware MQTT Port (Optional)
# Set to true or map port in docker-compose.prod.yml if external IoT hardware connects directly.
# Default setup uses internal Docker network for simulator and MQTT.
