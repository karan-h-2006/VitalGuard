# Postgres database name for local development.
POSTGRES_DB=vitalguard
# Postgres role for local development only.
POSTGRES_USER=vitalguard
# Postgres password for local development only; replace in any shared environment.
POSTGRES_PASSWORD=vitalguard

# RabbitMQ default user for local development only.
RABBITMQ_DEFAULT_USER=vitalguard
# RabbitMQ default password for local development only; replace in any shared environment.
RABBITMQ_DEFAULT_PASS=vitalguard
