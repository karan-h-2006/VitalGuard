# 1:1 edge-device identity used in every published contract payload.
VITALGUARD_DEVICE_ID=00000000-0000-4000-8000-000000000002
# Patient currently paired to VITALGUARD_DEVICE_ID (association model arrives later).
VITALGUARD_PATIENT_ID=00000000-0000-4000-8000-000000000001

# Local Docker Mosquitto endpoint; replace only these values for a cloud broker.
MQTT_HOST=localhost
MQTT_PORT=1883
# Optional broker credentials. Leave blank for the local Phase 0 Mosquitto service.
MQTT_USERNAME=
MQTT_PASSWORD=
# Enables TLS for a cloud MQTT endpoint.
MQTT_USE_TLS=false

# Append-only local persistence location for readings that cannot be published.
VITALGUARD_BUFFER_FILE=buffer.jsonl
# Moving-average history length for HR and SpO2 smoothing.
VITAL_FILTER_WINDOW_SIZE=5

# Physiological plausibility and smoothing-deviation thresholds for edge quality flags.
HEART_RATE_PLAUSIBLE_MIN=40
HEART_RATE_PLAUSIBLE_MAX=220
HEART_RATE_NOISY_DEVIATION=12
SPO2_PLAUSIBLE_MIN=70
SPO2_PLAUSIBLE_MAX=100
SPO2_NOISY_DEVIATION=2
# Retained reference fall heuristic thresholds (m/s² and degrees).
FALL_ACCELERATION_HIGH_THRESHOLD=11
FALL_ACCELERATION_LOW_THRESHOLD=10
FALL_PITCH_THRESHOLD=30
FALL_ROLL_THRESHOLD=30

# Demo controls. Disabled by default so normal development uses clean resting data.
VITALGUARD_INJECT_NOISE=false
VITALGUARD_TRIGGER_FALL=false
# Number of heart-rate sample cycles over which a deliberate deterioration ramps.
VITALGUARD_DETERIORATION_SAMPLES=0

# Heart rate / SpO2 publishing cadence and skin-temperature refresh cadence.
VITALS_INTERVAL_SECONDS=5
TEMPERATURE_INTERVAL_SECONDS=30
# Python logging verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Temporary verifier output path. The verifier is deleted in Module 2.
VERIFIER_OUTPUT_FILE=received_samples.jsonl
