{
  "name": "@vitalguard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VitalGuard HTTP API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --pretty",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap-admin": "tsx src/db/bootstrap-admin.ts"
  },
  "dependencies": {
    "@vitalguard/shared-types": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitalguard/config": "workspace:*",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.21.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
