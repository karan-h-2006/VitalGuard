NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local Docker Postgres (swap for Supabase URL in cloud without code changes)
DATABASE_URL=postgresql://vitalguard:vitalguard@localhost:5432/vitalguard

# Local Docker Redis (swap for Upstash URL in cloud)
REDIS_URL=redis://localhost:6379

# Local Docker RabbitMQ (swap for CloudAMQP URL in cloud)
RABBITMQ_URL=amqp://vitalguard:vitalguard@localhost:5672

# Browser origin allowed to call this API (web Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Required at boot. Generate a unique value, at least 16 characters long.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
ADMIN_JWT_EXPIRES_IN=30m
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_LOGIN_RATE_LIMIT_MAX=3
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
WEBSOCKET_POLL_INTERVAL_MS=500
ALLOW_ADDITIONAL_ADMINS=false
REQUIRE_PATIENT_CONSENT=true
ADMIN_TOTP_ENABLED=false
# Optional. Admins receive in-app notifications regardless of email settings.
# ADMIN_NOTIFY_EMAIL=admin@vitalguard.local
# RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@vitalguard.local

# Optional. Leave unset locally; set in cloud when Sentry is wired (Phase 1+).
# SENTRY_DSN=
