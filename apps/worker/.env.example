NODE_ENV=development
LOG_LEVEL=info

# Local Docker Postgres (swap for Supabase URL in cloud without code changes)
DATABASE_URL=postgresql://vitalguard:vitalguard@localhost:5432/vitalguard

# Local Docker Redis (swap for Upstash URL in cloud)
REDIS_URL=redis://localhost:6379

# Local Docker RabbitMQ (swap for CloudAMQP URL in cloud)
RABBITMQ_URL=amqp://vitalguard:vitalguard@localhost:5672

# Queue the worker will consume in Phase 1. Declared at connect-time later;
# Phase 0 only checks that the broker accepts a connection.
RABBITMQ_VITALS_QUEUE=vitals.readings

# Optional. Leave unset locally; set in cloud when Sentry is wired (Phase 1+).
# SENTRY_DSN=
