NODE_ENV=development
LOG_LEVEL=info

# Local Docker Postgres (swap for Supabase URL in cloud without code changes)
DATABASE_URL=postgresql://vitalguard:vitalguard@localhost:5432/vitalguard

# Local Docker Redis (swap for Upstash URL in cloud)
REDIS_URL=redis://localhost:6379

# Local Docker RabbitMQ (swap for CloudAMQP URL in cloud)
RABBITMQ_URL=amqp://vitalguard:vitalguard@localhost:5672

# Durable RabbitMQ topology for validated samples.
RABBITMQ_VITALS_QUEUE=vitals.ingest
VITALS_EXCHANGE=vitals
VITALS_DEADLETTER_QUEUE=vitals.deadletter

# Local Docker Mosquitto endpoint. Cloud broker configuration changes values only.
MQTT_HOST=localhost
MQTT_PORT=1883
# Optional Mosquitto/cloud broker credentials; leave blank for local Docker Mosquitto.
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Enable TLS when the configured MQTT broker requires it.
MQTT_USE_TLS=false
# Wildcard subscription for complete Module 1 vital-sample messages.
MQTT_VITALS_TOPIC=HMS/+/vitals

# Optional. Leave unset locally; set in cloud when Sentry is wired (Phase 1+).
# SENTRY_DSN=
